// Approach 2: schema-first codegen (atombender/go-jsonschema)
// Source of truth: schema.json. Go struct generated by `go-jsonschema`.
// Schema is also handed to the LLM verbatim — no derivation gap.
package codegen

import (
	"encoding/json"
	"fmt"
	"os"

	"github.com/xeipuuv/gojsonschema"
)

func Run() {
	// 1. The hand-written schema IS the source of truth.
	schemaBytes, err := os.ReadFile("../approach2_codegen/schema.json")
	if err != nil {
		panic(err)
	}
	fmt.Println("=== schema (source of truth, handed to LLM) ===")
	fmt.Println(string(schemaBytes))

	// 2. Reverse validate via gojsonschema (using schema directly).
	loader := gojsonschema.NewBytesLoader(schemaBytes)
	bad := `{"path":"/x","mode":"invalid","options":{},"actions":[]}`
	res, _ := gojsonschema.Validate(loader, gojsonschema.NewStringLoader(bad))
	fmt.Println("\n=== validate bad input (mode=invalid) ===")
	fmt.Println("valid:", res.Valid())
	for _, e := range res.Errors() {
		fmt.Println(" -", e)
	}

	// 3. Discriminator test: type=create but supplying `id` (wrong variant).
	wrongVariant := `{"path":"/x","mode":"read","options":{},"actions":[{"type":"create","id":"abc"}]}`
	res2, _ := gojsonschema.Validate(loader, gojsonschema.NewStringLoader(wrongVariant))
	fmt.Println("\n=== validate wrong-variant action (type=create + id) ===")
	fmt.Println("valid:", res2.Valid())
	for _, e := range res2.Errors() {
		fmt.Println(" -", e)
	}

	// 4. Generated-code parse: also rejects bad mode (UnmarshalJSON enforces enum).
	var st SchemaJson
	if err := json.Unmarshal([]byte(bad), &st); err != nil {
		fmt.Println("\n=== generated UnmarshalJSON rejects bad input ===")
		fmt.Println(" -", err)
	}
}