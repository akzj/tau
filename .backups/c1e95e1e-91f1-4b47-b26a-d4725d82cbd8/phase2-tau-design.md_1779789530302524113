### 最小 demo case（验证接入点合理性）

```go
// "echo agent + 1 tool + 1 session" — 最小完整循环
func MinimalAgent(ctx context.Context, openaiKey string) error {
    sess, err := core.NewSession(ctx, core.SessionOptions{
        SystemPrompt: func(s *core.Session) (string, error) {
            return "You are a helper. Use tools when needed.", nil
        },
    })
    if err != nil { return err }
    defer sess.Cancel()

    // Register provider
    sess.Providers.Register("openai", openai.NewProvider(openaiKey))

    // Register one tool
    sess.Tools.Register(core.Tool{
        Name:        "echo",
        Description: "Echo back the input string.",
        Schema:      schema.For[EchoArgs](),  // §2.7-决定后形态
        Execute: func(ctx context.Context, callID string, params any, onUpdate func(core.PartialResult)) (core.ToolResult, error) {
            args := params.(EchoArgs)
            return core.ToolResult{Content: []core.Content{{Text: args.Msg}}}, nil
        },
    })
    sess.Tools.SetActive([]string{"echo"})

    // Run one turn
    loop := core.NewLoop()
    run, err := loop.Prompt(ctx, sess, core.UserInput{Text: "echo hello"})
    if err != nil { return err }

    // Consume events
    for ev := range run.Events {
        // product layer renders / forwards
        _ = ev
    }

    _, err = run.Done()
    return err
}
```

≤30 行，覆盖 §5.1–§5.5。**写得出来 → 接入点设计 closed-form**。

